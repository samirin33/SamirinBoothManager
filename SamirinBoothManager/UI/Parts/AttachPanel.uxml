<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/samirin33/SamirinBoothManager/UI/Style/SBM_Style.uss?fileID=7433441132597879392&amp;guid=a6b07b6544dc39342827d960de9bb6d2&amp;type=3#SBM_Style" />
    <ui:VisualElement name="Background" class="SBM_Text" style="background-color: rgba(20, 18, 35, 0.9); height: 100%; width: 100%; border-left-color: rgb(163, 137, 165); border-right-color: rgb(163, 137, 165); border-top-color: rgb(163, 137, 165); border-bottom-color: rgb(163, 137, 165); border-top-width: 3px; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; overflow: visible;">
        <ui:VisualElement style="flex-grow: 1; padding-right: 50px; padding-left: 50px; padding-top: 25px;">
            <ui:VisualElement style="flex-grow: 1; background-color: rgba(0, 0, 0, 0.5); padding-top: 5px; padding-right: 10px; padding-bottom: 5px; padding-left: 10px; overflow: visible;">
                <ui:VisualElement name="VariationAvailableCallout" style="flex-grow: 1; position: absolute; width: 150px; justify-content: flex-start; height: 150px; top: -99px; right: -22px;">
                    <ui:VisualElement name="CalloutBackground" style="position: absolute; width: 100%; height: 100%; background-image: url(&quot;project://database/Assets/samirin33/SamirinBoothManager/Image/CalloutBackground.png?fileID=2800000&amp;guid=7de699bbd406feb41895138e3b47cc65&amp;type=3#CalloutBackground&quot;); -unity-background-scale-mode: scale-to-fit;" />
                    <ui:Label tabindex="-1" text="別バリエーションが使用できます！" parse-escape-sequences="true" display-tooltip-when-elided="true" name="CalloutText" style="position: absolute; width: 100%; height: 100%; color: rgb(75, 75, 75); font-size: 8px; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0;" />
                </ui:VisualElement>
                <ui:DropdownField label="バリエーションを選択" index="0" choices="バリエーション1" name="VariationDropDown" style="width: 100%; font-size: 13px; height: 20px; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-right: 10px; padding-left: 10px;" />
                <ui:Label tabindex="-1" text="バリエーションの説明" parse-escape-sequences="true" display-tooltip-when-elided="true" name="VariationDiscription" style="flex-grow: 1;" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="SetupGroup" style="position: relative; width: 100%; height: 100px; bottom: 0;">
            <samirin33.SamirinBoothManager.UI.Parts.SBM_Button background-color="#439796FF" name="ButtonSetup" text="{アイテム名}をアバターにセットする！" class="SetupButton" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
